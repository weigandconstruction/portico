defmodule <%= @module %>.Client do
  @moduledoc """
  HTTP client for <%= @module %> API.

  Requires Req 0.6.1 or newer (0.7.0 and 0.7.1 are not supported).

  ## Generation details

  * Spec: <%= Portico.Helpers.escape_doc(@spec) %>
<%= if @spec_info["version"] do %>  * Spec version: <%= Portico.Helpers.escape_doc(to_string(@spec_info["version"])) %>
<% end %>  * Portico: <%= @portico_ref %>
  * Generated on: <%= @generated_on %>
  """

  defmodule HTTPError do
    @moduledoc """
    Represents an HTTP error response (4xx/5xx status codes).
    """
    defexception [:status, :body, :message, headers: %{}]

    @type t :: %__MODULE__{
            status: non_neg_integer(),
            body: any(),
            headers: %{optional(binary()) => [binary()]},
            message: String.t()
          }

    def exception(%Req.Response{status: status, body: body, headers: headers}) do
      %{exception({status, body}) | headers: headers}
    end

    def exception({status, body}) do
      %__MODULE__{
        status: status,
        body: body,
        message: "HTTP #{status} error"
      }
    end
  end

  defmodule TransportError do
    @moduledoc """
    Represents a transport-level error (network, timeout, DNS, etc.).
    """
    defexception [:reason, :message]

    @type t :: %__MODULE__{
            reason: any(),
            message: String.t()
          }

    def exception(reason) do
      %__MODULE__{
        reason: reason,
        message: "Transport error: #{inspect(reason)}"
      }
    end
  end

<%= if @base_url do %>  @default_base_url <%= inspect(@base_url) %>

  @doc """
  Creates a new client with the given options.

  Options are merged in the following order (later values override earlier ones):
  1. Application config (e.g., from config/test.exs)
  2. Default base URL (if not already set)
  3. Provided options

  ## Examples

      # Using default base URL
      client = <%= @module %>.Client.new()

      # With authentication using default URL
      client = <%= @module %>.Client.new(auth: {:bearer, "your-token"})

      # Override base URL
      client = <%= @module %>.Client.new(base_url: "https://staging.example.com")

      # Override base URL with auth
      client = <%= @module %>.Client.new(
        base_url: "https://staging.example.com",
        auth: {:bearer, "staging-token"}
      )

      # With additional options
      client = <%= @module %>.Client.new(
        timeout: 30_000,
        auth: {:bearer, "token"},
        retry: :transient
      )

  ## Response headers

  Generated functions return `{:ok, body}`. To get the whole `Req.Response`
  instead, for example to read pagination headers, create the client with
  `return: :response`:

      client = <%= @module %>.Client.new(return: :response)
      {:ok, %Req.Response{headers: headers, body: body}} = <%= @module %>.Client.request(client, url: "/endpoint")

  ## Application Configuration

  You can set default options in your application config:

      # config/test.exs
      config :my_app,
        <%= Portico.Helpers.module_to_config_key(@module) %>: [
          plug: {Req.Test, MyApp.MockServer}
        ]

      # config/dev.exs
      config :my_app,
        <%= Portico.Helpers.module_to_config_key(@module) %>: [
          retry: false,
          cache: true
        ]

  """
  @spec new(keyword()) :: Req.Request.t()
  def new(options \\ []) when is_list(options) do
    app = Application.get_application(__MODULE__) || :portico

    Application.get_env(app, :<%= Portico.Helpers.module_to_config_key(@module) %>, [])
    |> Keyword.merge(options)
    |> Keyword.put_new(:base_url, @default_base_url)
    |> build()
  end<% else %>  @doc """
  Creates a new client with the given options.

  Options are merged in the following order (later values override earlier ones):
  1. Application config (e.g., from config/test.exs)
  2. Provided options (must include base_url)

  ## Examples

      # With base URL and auth
      client = <%= @module %>.Client.new(
        base_url: "https://api.example.com",
        auth: {:bearer, "your-token"}
      )

      # Basic auth
      client = <%= @module %>.Client.new(
        base_url: "https://api.example.com",
        auth: {:basic, "user:pass"}
      )

      # With additional options
      client = <%= @module %>.Client.new(
        base_url: "https://api.example.com",
        timeout: 30_000,
        auth: {:bearer, "token"}
      )

  ## Response headers

  Generated functions return `{:ok, body}`. To get the whole `Req.Response`
  instead, for example to read pagination headers, create the client with
  `return: :response`:

      client = <%= @module %>.Client.new(return: :response)
      {:ok, %Req.Response{headers: headers, body: body}} = <%= @module %>.Client.request(client, url: "/endpoint")

  ## Application Configuration

  You can set default options in your application config:

      # config/test.exs
      config :my_app,
        <%= Portico.Helpers.module_to_config_key(@module) %>: [
          plug: {Req.Test, MyApp.MockServer}
        ]

      # config/dev.exs
      config :my_app,
        <%= Portico.Helpers.module_to_config_key(@module) %>: [
          retry: false,
          cache: true
        ]

  Note: base_url must still be provided in the options when creating the client.

  """
  @spec new(keyword()) :: Req.Request.t()
  def new(options) when is_list(options) do
    app = Application.get_application(__MODULE__) || :portico

    options =
      Application.get_env(app, :<%= Portico.Helpers.module_to_config_key(@module) %>, [])
      |> Keyword.merge(options)

    unless Keyword.has_key?(options, :base_url) do
      raise ArgumentError, "base_url is required"
    end

    build(options)
  end<% end %>

  # :return isn't a Req option, so it's kept in the request's private data
  defp build(options) do
    {return, options} = Keyword.pop(options, :return, :body)

    unless return in [:body, :response] do
      raise ArgumentError, "return must be :body or :response, got: #{inspect(return)}"
    end

    options
    |> Req.new()
    |> Req.Request.put_private(:portico_return, return)
  end

  @doc """
  Makes an HTTP request using the provided client.

  Returns `{:ok, body}` on success (2xx status codes), or `{:ok, %Req.Response{}}`
  for a client created with `return: :response`. Returns `{:error, exception}`
  on failure; an `HTTPError` includes the response headers.

  ## Examples

      # GET request
      {:ok, data} = <%= @module %>.Client.request(client, method: :get, url: "/endpoint")

      # POST request with JSON body
      case <%= @module %>.Client.request(client, method: :post, url: "/endpoint", json: %{key: "value"}) do
        {:ok, body} -> handle_success(body)
        {:error, %HTTPError{status: 404}} -> handle_not_found()
        {:error, %TransportError{}} -> handle_network_error()
      end

  """
  @spec request(Req.Request.t(), keyword()) :: {:ok, any()} | {:error, Exception.t()}
  def request(client, options \\ []) do
    client
    |> clean_options(options)
    |> Req.request()
    |> case do
      {:ok, %{status: status} = response} when status in 200..299 ->
        case Req.Request.get_private(client, :portico_return, :body) do
          :response -> {:ok, response}
          :body -> {:ok, response.body}
        end

      {:ok, response} ->
        {:error, HTTPError.exception(response)}

      {:error, %Req.TransportError{} = error} ->
        {:error, TransportError.exception(error)}

      {:error, error} ->
        {:error, TransportError.exception(error)}
    end
  end

  # Filter out nil values from headers and params
  defp clean_options(client, options) do
    cleaned_options =
      options
      |> Enum.map(fn
        {:headers, headers} when is_list(headers) ->
          {:headers, Enum.reject(headers, fn {_k, v} -> is_nil(v) end)}

        {:params, params} when is_list(params) ->
          {:params, Enum.flat_map(params, &expand_param/1)}

        {:form_multipart, fields} ->
          {:form_multipart, Enum.map(fields, &multipart_field/1)}

        other ->
          other
      end)

    Req.merge(client, cleaned_options)
  end

  # Req only encodes integers, binaries, iodata, and streams as multipart
  # values, so send booleans and floats as their string form
  defp multipart_field({name, {value, options}}) when is_list(options),
    do: {name, {multipart_value(value), options}}

  defp multipart_field({name, value}), do: {name, multipart_value(value)}

  defp multipart_value(value) when is_boolean(value) or is_float(value), do: to_string(value)
  defp multipart_value(value), do: value

  # Drops nil params and sends a list as a repeated key (ids=1&ids=2)
  defp expand_param({_key, nil}), do: []
  defp expand_param({key, values}) when is_list(values), do: Enum.map(values, &{key, &1})
  defp expand_param(param), do: [param]

  @doc """
  Escapes a value for use as one URL path segment, so characters like `/`,
  `?`, and `#` in it can't change which URL is requested.
  """
  @spec encode_path(term()) :: String.t()
  def encode_path(value), do: value |> to_string() |> URI.encode(&URI.char_unreserved?/1)

  @doc """
  Joins a list query parameter with commas (`ids=1,2`), for parameters the
  spec marks `explode: false`.
  """
  @spec comma_separated(list() | nil) :: String.t() | nil
  def comma_separated(nil), do: nil
  def comma_separated(values) when is_list(values), do: Enum.join(values, ",")
  def comma_separated(value), do: value
end
